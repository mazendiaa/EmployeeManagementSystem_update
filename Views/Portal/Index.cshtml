@model EmployeeManagementSystem.Models.EmployeePortalViewModel
@using EmployeeManagementSystem.Models
@{ ViewData["Title"] = "My workspace"; var monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month); }
<section class="portal-page">
    <div class="portal-top-row"><div class="portal-welcome"><span class="eyebrow">YOUR WORKSPACE</span><h1>Good to have you here, @Model.Employee.FullName.Split(' ').FirstOrDefault().</h1><p>Here's your attendance and work for @monthName.</p></div><form method="get" class="portal-month-picker"><label for="portal-month">Month</label><select id="portal-month" name="month" class="form-select">@for (var m = 1; m <= 12; m++) { <option value="@m" selected="@(Model.Month == m)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option> }</select><input type="number" name="year" value="@Model.Year" class="form-control" aria-label="Year" min="2000" max="@(DateTime.Today.Year + 1)"/><button type="submit" class="btn btn-primary">View</button></form></div>
    <div class="portal-profile-strip surface-card"><span class="profile-placeholder profile-placeholder-small">@Model.Employee.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.FirstOrDefault()</span><div><strong>@Model.Employee.FullName</strong><small>@(Model.Employee.JobTitle?.Title ?? "Pending HR assignment") <span>·</span> @(Model.Employee.Department?.Name ?? "Pending HR assignment")</small></div><a asp-controller="Portal" asp-action="Profile" class="text-link">Personal information & requests <span>→</span></a></div>
    <div class="portal-month-stats"><article><span>WORK DAYS</span><strong>@Model.Attendance.Count(a => a.ClockIn.HasValue)</strong><small>Attendance entries in @monthName</small></article><article><span>HOURS RECORDED</span><strong>@Model.TotalHours.ToString("0.#")</strong><small>Hours with clock-in and clock-out</small></article><article><span>TASKS COMPLETED</span><strong>@Model.Tasks.Count(t => t.Status == EmployeeTaskStatuses.Completed)</strong><small>Finished this month</small></article><article><span>TO DO</span><strong>@Model.Tasks.Count(t => t.Status != EmployeeTaskStatuses.Completed)</strong><small>Tasks still in progress</small></article></div>
    <div class="portal-content-grid">
        <section class="surface-card portal-section"><div class="card-heading"><div><h2>My attendance</h2><p>Your clock-in and clock-out times for @monthName</p></div></div><div class="table-responsive table-shell"><table class="table align-middle portal-table"><thead><tr><th>Date</th><th>Clock in</th><th>Clock out</th><th>Hours</th><th>Note</th></tr></thead><tbody>
        @foreach (var record in Model.Attendance) { var shiftHours = record.ClockIn.HasValue && record.ClockOut.HasValue ? (record.ClockOut.Value - record.ClockIn.Value).TotalHours : (double?)null; <tr><td><strong>@record.WorkDate.ToString("ddd, MMM d")</strong></td><td>@(record.ClockIn?.ToString(@"hh\:mm") ?? "—")</td><td>@(record.ClockOut?.ToString(@"hh\:mm") ?? "—")</td><td>@(shiftHours.HasValue ? shiftHours.Value.ToString("0.#") + " h" : "—")</td><td>@(string.IsNullOrWhiteSpace(record.Notes) ? "—" : record.Notes)</td></tr> }
        @if (!Model.Attendance.Any()) { <tr><td colspan="5" class="table-empty">No attendance records for @monthName. Your HR team manages these entries.</td></tr> }
        </tbody></table></div></section>
        <section class="surface-card portal-section"><div class="card-heading"><div><h2>My tasks</h2><p>What's due and what you've completed this month</p></div></div><div class="employee-task-list">
        @foreach (var task in Model.Tasks)
        {
            <article class="employee-task-card"><div class="employee-task-card-top"><span class="task-status-pill task-status-@task.Status.ToLowerInvariant().Replace(" ", "-")">@task.Status</span>@if (task.DueDate.HasValue) { <small>Due @task.DueDate.Value.ToString("MMM d")</small> }</div><h3>@task.Title</h3>@if (!string.IsNullOrWhiteSpace(task.Description)) { <p>@task.Description</p> }
                @if (task.Status == EmployeeTaskStatuses.Completed) { <form asp-action="UpdateTaskStatus" method="post"><input type="hidden" name="id" value="@task.Id"/><input type="hidden" name="status" value="@EmployeeTaskStatuses.InProgress"/><input type="hidden" name="month" value="@Model.Month"/><input type="hidden" name="year" value="@Model.Year"/><button type="submit" class="task-reopen">Reopen task</button></form> }
                else { <form asp-action="UpdateTaskStatus" method="post"><input type="hidden" name="id" value="@task.Id"/><input type="hidden" name="status" value="@EmployeeTaskStatuses.Completed"/><input type="hidden" name="month" value="@Model.Month"/><input type="hidden" name="year" value="@Model.Year"/><button type="submit" class="btn btn-primary btn-sm task-complete">Mark complete <span>✓</span></button></form> }
            </article>
        }
        @if (!Model.Tasks.Any()) { <div class="tracking-empty"><span>✦</span><strong>Your task list is clear.</strong><p>New tasks assigned by your HR team will show up here.</p></div> }
        </div></section>
    </div>
    <div class="profile-note portal-hr-note"><span>✦</span>Need to update your profile or attendance? Reach out to your HR administrator.</div>
</section>

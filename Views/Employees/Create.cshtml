@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Create Employee";
}

<section class="create-employee-card">
    <div class="create-heading">
        <div>
            <span class="eyebrow">PEOPLE DIRECTORY</span>
            <h1>Create Employee</h1>
        </div>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="employee-create-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="create-form-grid">
            <section class="form-panel personal-panel">
                <h2>Personal Information</h2>
                <div class="form-panel-body">
                    <div class="field-group">
                        <label asp-for="FullName" class="form-label"></label>
                        <div class="input-with-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 20c.5-4 3.2-6 7.5-6s7 2 7.5 6"/></svg>
                            <input asp-for="FullName" class="form-control" placeholder="Enter full name" autocomplete="name" />
                        </div>
                        <span asp-validation-for="FullName" class="field-error"></span>
                    </div>
                    <div class="field-group">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-with-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
                            <input asp-for="Email" class="form-control" placeholder="name@company.com" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="field-error"></span>
                        <small class="field-hint">Each employee must have a unique email address.</small>
                    </div>
                    <div class="field-group">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <div class="input-with-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h3l1.5 4-2 1.5a15 15 0 0 0 6 6l1.5-2 4 1.5v3c0 1.2-1 2-2.2 2C11 18.5 5.5 13 4 5.2 3.8 4 4.5 3 5.7 3H7Z"/></svg>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+20 1X XXX XXXX" autocomplete="tel" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="field-error"></span>
                        <small class="field-hint">Each employee must have a unique phone number.</small>
                    </div>
                </div>
            </section>

            <section class="form-panel professional-panel">
                <h2>Professional Details</h2>
                <div class="form-panel-body">
                    <div class="field-group">
                        <label asp-for="HireDate" class="form-label"></label>
                        <input asp-for="HireDate" class="form-control" type="date" required />
                        <span asp-validation-for="HireDate" class="field-error"></span>
                    </div>
                    <div class="field-group">
                        <label asp-for="Salary" class="form-label"></label>
                        <div class="salary-input">
                            <input asp-for="Salary" class="form-control" type="number" min="1" step="0.01" placeholder="0.00" required />
                        </div>
                        <span asp-validation-for="Salary" class="field-error"></span>
                    </div>
                    <div class="field-group">
                        <label asp-for="DepartmentId" class="form-label"></label>
                        <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments" required>
                            <option value="">Select department</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="field-error"></span>
                    </div>
                    <div class="field-group">
                        <label asp-for="JobTitleId" class="form-label"></label>
                        <select asp-for="JobTitleId" class="form-select" asp-items="ViewBag.JobTitles" required>
                            <option value="">Select job title</option>
                        </select>
                        <span asp-validation-for="JobTitleId" class="field-error"></span>
                    </div>
                </div>
            </section>

            <section class="form-panel additional-panel">
                <h2>Additional Information</h2>
                <div class="form-panel-body">
                    <label for="profileImage" class="form-label">Profile Image</label>
                    <label class="upload-zone" id="uploadZone" for="profileImage">
                        <input id="profileImage" type="file" name="profileImage" accept=".jpg,.jpeg,.png,.gif,image/jpeg,image/png,image/gif" />
                        <span class="upload-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg></span>
                        <span class="upload-copy"><strong id="uploadTitle">Drag and drop or click to upload Profile Image</strong><span id="uploadName">JPG, PNG or GIF · up to 2 MB</span></span>
                    </label>
                    <span asp-validation-for="ProfileImagePath" class="field-error"></span>
                </div>
            </section>
        </div>

        <div class="create-actions">
            <a asp-action="Index" class="btn btn-outline-back"><span aria-hidden="true">‹</span> Back</a>
            <button type="submit" class="btn btn-primary create-submit"><span aria-hidden="true">✓</span> Create Employee</button>
        </div>
    </form>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (() => {
            const input = document.getElementById('profileImage');
            const zone = document.getElementById('uploadZone');
            const fileName = document.getElementById('uploadName');
            if (!input || !zone) return;
            const showFile = file => { if (file) fileName.textContent = file.name; };
            input.addEventListener('change', () => showFile(input.files[0]));
            ['dragenter', 'dragover'].forEach(eventName => zone.addEventListener(eventName, event => {
                event.preventDefault(); zone.classList.add('is-dragging');
            }));
            ['dragleave', 'drop'].forEach(eventName => zone.addEventListener(eventName, event => {
                event.preventDefault(); zone.classList.remove('is-dragging');
            }));
            zone.addEventListener('drop', event => {
                const files = event.dataTransfer.files;
                if (files.length) { input.files = files; showFile(files[0]); }
            });
        })();
    </script>
}

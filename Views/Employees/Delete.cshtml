@model EmployeeManagementSystem.Models.Employee
@{ ViewData["Title"] = "Remove employee"; }
<section class="edit-page"><a asp-action="Details" asp-route-id="@Model.Id" class="back-link">← Employee details</a><div class="edit-heading"><span class="eyebrow">EMPLOYEE DIRECTORY</span><h1>Remove @Model.FullName?</h1><p>This permanently removes the employee record and their PeopleDesk access.</p></div><div class="surface-card edit-card"><div class="delete-summary"><span class="delete-mark">!</span><div><strong>This also removes linked attendance and tasks.</strong><p>The employee login, attendance history, and assigned tasks will be deleted with this record.</p></div></div><dl class="delete-employee-meta"><div><dt>Work email</dt><dd>@Model.Email</dd></div><div><dt>Department</dt><dd>@(Model.Department?.Name ?? "Pending HR assignment")</dd></div><div><dt>Date joined</dt><dd>@(Model.HireDate?.ToString("MMMM d, yyyy") ?? "Pending HR assignment")</dd></div></dl><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button type="submit" class="btn btn-danger">Remove employee and all records</button> <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light">Keep employee</a></form></div></section>

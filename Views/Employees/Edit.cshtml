@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Edit Employee";
}

<h2>Edit Employee</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_EmployeeForm" model="Model" />
    <div class="mb-3">
        <label class="form-label">Profile Image</label>
        @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
        {
            <div class="mb-2 current-profile-image">
                <img src="@Model.ProfileImagePath" class="employee-thumb" alt="Current profile image" />
                <label class="form-check profile-image-remove">
                    <input class="form-check-input" type="checkbox" name="removeProfileImage" value="true" />
                    <span class="form-check-label">Remove current image</span>
                </label>
            </div>
        }
        <input type="file" name="profileImage" class="form-control" accept="image/*" />
        <small class="text-muted">Uploading a new image replaces the current one.</small>
        <span asp-validation-for="ProfileImagePath" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

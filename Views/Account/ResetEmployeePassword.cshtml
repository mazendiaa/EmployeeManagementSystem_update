@model EmployeeManagementSystem.Models.UserAccount
@{ ViewData["Title"] = "Reset employee password"; }
<section class="edit-page"><a asp-controller="Employees" asp-action="Details" asp-route-id="@Model.EmployeeId" class="back-link">← Employee details</a><div class="edit-heading"><span class="eyebrow">HR ACCOUNT ACCESS</span><h1>Reset sign-in password</h1><p>Create a one-time temporary password for @Model.FullName.</p></div><div class="surface-card edit-card"><div class="account-summary"><span class="account-summary-icon">⌑</span><div><strong>@Model.Email</strong><p>The current password stays private. The employee should replace this temporary one after signing in.</p></div></div><form asp-action="ResetEmployeePasswordConfirmed" asp-route-id="@Model.EmployeeId" method="post"><button type="submit" class="btn btn-primary">Generate temporary password</button> <a asp-controller="Employees" asp-action="Details" asp-route-id="@Model.EmployeeId" class="btn btn-light">Cancel</a></form></div></section>

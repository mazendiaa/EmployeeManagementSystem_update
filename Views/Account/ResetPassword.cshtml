@model EmployeeManagementSystem.Models.ResetPasswordViewModel
@{ ViewData["Title"] = "Reset password"; }
<div class="auth-layout"><section class="auth-story"><a class="brand auth-brand" asp-action="Login"><img class="brand-logo-mark" src="~/images/peopledesk-mark.png" alt="PeopleDesk logo"/><span class="brand-copy"><strong>people<span>desk</span></strong><small>PEOPLE OPERATIONS</small></span></a><div class="auth-story-copy"><span class="eyebrow">A SECURE RESET</span><h1>Choose a new<br/>password.</h1><p>Make it at least 10 characters and keep it somewhere safe.</p><div class="auth-illustration"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><img class="illustration-center" src="~/images/peopledesk-mark.png" alt=""/></div></div><div class="auth-story-foot">PEOPLE FIRST, EVERY DAY</div></section><section class="auth-panel"><div class="auth-form-wrap"><div class="auth-mobile-brand"><img class="brand-logo-mark" src="~/images/peopledesk-mark.png" alt=""/><strong>people<span>desk</span></strong></div>
    @if (ViewBag.InvalidReset == true)
    { <span class="eyebrow">LINK NO LONGER AVAILABLE</span><h2>Let's send you a new link.</h2><p class="auth-subtitle">This reset link is invalid, expired, or already used.</p><a asp-action="ForgotPassword" class="btn btn-primary auth-submit">Request another link <span>→</span></a> }
    else
    { <span class="eyebrow">PASSWORD RECOVERY</span><h2>Set a new password</h2><p class="auth-subtitle">Choose a new password for your PeopleDesk account.</p><form asp-action="ResetPassword" method="post" class="auth-form"><input asp-for="Token" type="hidden"/><div asp-validation-summary="ModelOnly" class="auth-validation"></div><div class="field-group"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="At least 10 characters"/><span asp-validation-for="Password" class="field-error"></span></div><div class="field-group"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Enter it again"/><span asp-validation-for="ConfirmPassword" class="field-error"></span></div><button type="submit" class="btn btn-primary auth-submit">Update password <span>→</span></button></form> }
    <div class="auth-secure"><span>◈</span> Your new password is securely hashed</div>
</div><div class="auth-panel-foot"><a asp-action="Login">← Back to sign in</a></div></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }

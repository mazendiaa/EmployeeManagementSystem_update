@{ ViewData["Title"] = "Password updated"; }
<div class="auth-layout"><section class="auth-story"><a class="brand auth-brand" asp-action="Login"><img class="brand-logo-mark" src="~/images/peopledesk-mark.png" alt="PeopleDesk logo"/><span class="brand-copy"><strong>people<span>desk</span></strong><small>PEOPLE OPERATIONS</small></span></a><div class="auth-story-copy"><span class="eyebrow">ALL SET</span><h1>@(TempData["EmployeeApprovalPending"] is true ? "Password request sent." : "Your account is back.")</h1><p>@(TempData["EmployeeApprovalPending"] is true ? "Your new password will become active after HR approval." : "Your new password is ready to use.")</p><div class="auth-illustration"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><img class="illustration-center" src="~/images/peopledesk-mark.png" alt=""/></div></div><div class="auth-story-foot">PEOPLE FIRST, EVERY DAY</div></section><section class="auth-panel"><div class="auth-form-wrap"><span class="recovery-icon recovery-icon-large">✓</span><span class="eyebrow">@(TempData["EmployeeApprovalPending"] is true ? "WAITING FOR APPROVAL" : "PASSWORD UPDATED")</span><h2>@(TempData["EmployeeApprovalPending"] is true ? "HR will review your request." : "You're ready to sign in.")</h2><p class="auth-subtitle">@(TempData["EmployeeApprovalPending"] is true ? "We sent your password change request to HR. It will take effect once approved. You can keep using your current password in the meantime." : "Your password has been changed. Sign in with your new password.")</p><a asp-action="Login" asp-route-role="@(TempData["EmployeeApprovalPending"] is true ? AccountRoles.Employee : AccountRoles.Hr)" class="btn btn-primary auth-submit">Go to sign in <span>→</span></a></div><div class="auth-panel-foot">© @DateTime.Today.Year PeopleDesk <span>·</span> Made for better workdays</div></section></div>

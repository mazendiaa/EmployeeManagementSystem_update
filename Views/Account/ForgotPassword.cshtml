@model EmployeeManagementSystem.Models.ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot password"; }
<div class="auth-layout"><section class="auth-story"><a class="brand auth-brand" asp-action="Login"><img class="brand-logo-mark" src="~/images/peopledesk-mark.png" alt="PeopleDesk logo"/><span class="brand-copy"><strong>people<span>desk</span></strong><small>PEOPLE OPERATIONS</small></span></a><div class="auth-story-copy"><span class="eyebrow">WE'LL HELP YOU GET BACK IN</span><h1>A fresh start<br/>is one email away.</h1><p>Reset links are private, short-lived, and only work once.</p><div class="auth-illustration"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><img class="illustration-center" src="~/images/peopledesk-mark.png" alt=""/></div><div class="auth-quote"><span>“</span><p>Your people hub is right where you left it.</p></div></div><div class="auth-story-foot">PEOPLE FIRST, EVERY DAY</div></section>
<section class="auth-panel"><div class="auth-form-wrap"><div class="auth-mobile-brand"><img class="brand-logo-mark" src="~/images/peopledesk-mark.png" alt=""/><strong>people<span>desk</span></strong></div><a asp-action="Login" class="back-link">← Back to sign in</a><span class="eyebrow">PASSWORD RECOVERY</span><h2>Forgot your password?</h2><p class="auth-subtitle">Enter your work email and we'll send a secure reset link.</p>
    @if (ViewBag.RequestSubmitted == true)
    {
        <div class="recovery-message"><span class="recovery-icon">@(ViewBag.EmailNotConfigured == true || ViewBag.EmailDeliveryFailed == true ? "i" : "✓")</span><div><strong>@(ViewBag.EmailNotConfigured == true ? "Email recovery isn't set up yet." : ViewBag.EmailDeliveryFailed == true ? "We couldn't send the reset email." : "Check your inbox.")</strong><p>@(ViewBag.EmailNotConfigured == true || ViewBag.EmailDeliveryFailed == true ? "Please ask your HR administrator to reset your password. Your HR team can issue a secure temporary password." : "If an account matches that address, a reset link will arrive shortly. The link expires in 30 minutes.")</p></div></div>
        @if (ViewBag.EmailNotConfigured == true || ViewBag.EmailDeliveryFailed == true) { <a asp-action="Login" asp-route-role="HR" class="btn btn-primary auth-submit recovery-hr-link">Return to HR sign in <span>→</span></a> }
    }
    else
    {
        <form asp-action="ForgotPassword" method="post" class="auth-form"><div asp-validation-summary="ModelOnly" class="auth-validation"></div><div class="field-group"><label asp-for="Email" class="form-label"></label><div class="auth-input-wrap"><span>✉</span><input asp-for="Email" class="form-control" autocomplete="username" placeholder="you@company.com"/></div><span asp-validation-for="Email" class="field-error"></span></div><button type="submit" class="btn btn-primary auth-submit">Send reset link <span>→</span></button></form>
    }
    <div class="recovery-contact"><strong>Prefer a hand from your team?</strong><p>Your HR administrator can reset your password and give you a one-time sign-in code.</p><a asp-action="Login" asp-route-role="HR">Go to HR sign in</a></div>
    <div class="auth-secure"><span>◈</span> We never show or email your current password</div>
</div><div class="auth-panel-foot">© @DateTime.Today.Year PeopleDesk <span>·</span> Made for better workdays</div></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }

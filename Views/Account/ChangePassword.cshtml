@model EmployeeManagementSystem.Models.ChangePasswordViewModel
@{ ViewData["Title"] = "Change password"; }
<section class="edit-page"><a asp-controller="@(User.IsInRole("HR") ? "Home" : "Portal")" asp-action="Index" class="back-link">← My workspace</a><div class="edit-heading"><span class="eyebrow">ACCOUNT SECURITY</span><h1>@(User.HasClaim("MustChangePassword", "True") ? "Create your password" : "Change your password")</h1><p>@(User.HasClaim("MustChangePassword", "True") ? "Choose a new password to finish setting up your account." : "Use a new password you haven't used for this account before.")</p></div><div class="surface-card edit-card"><form asp-action="ChangePassword" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div>@if (!User.HasClaim("MustChangePassword", "True")) { <div class="field-group"><label asp-for="CurrentPassword" class="form-label"></label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password"/><span asp-validation-for="CurrentPassword" class="field-error"></span></div> }<div class="field-group"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="At least 10 characters"/><span asp-validation-for="NewPassword" class="field-error"></span></div><div class="field-group"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="field-error"></span></div><div class="create-actions"><button type="submit" class="btn btn-primary">@(User.HasClaim("MustChangePassword", "True") ? "Create password" : "Save new password")</button></div></form></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }

@model EmployeeManagementSystem.Models.AccountCreationViewModel
@{ ViewData["Title"] = "Set up HR access"; }
<div class="auth-layout setup-layout"><section class="auth-story"><a class="brand auth-brand" asp-action="Login"><img class="brand-logo-mark" src="~/images/peopledesk-mark.png" alt="PeopleDesk logo"/><span class="brand-copy"><strong>people<span>desk</span></strong><small>PEOPLE OPERATIONS</small></span></a><div class="auth-story-copy"><span class="eyebrow">YOUR WORKSPACE STARTS HERE</span><h1>Set up your<br/>people hub.</h1><p>Create the first HR administrator account to get started.</p><div class="auth-illustration"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><span class="illustration-person person-a">H</span><span class="illustration-person person-b">R</span><img class="illustration-center" src="~/images/peopledesk-mark.png" alt=""/></div></div><div class="auth-story-foot">PEOPLE FIRST, EVERY DAY</div></section>
<section class="auth-panel"><div class="auth-form-wrap"><div class="auth-mobile-brand"><img class="brand-logo-mark" src="~/images/peopledesk-mark.png" alt=""/><strong>people<span>desk</span></strong></div><span class="eyebrow">FIRST-TIME SETUP</span><h2>Create your HR account</h2><p class="auth-subtitle">This account will have access to HR management tools.</p><form asp-action="Setup" method="post" class="auth-form"><div asp-validation-summary="ModelOnly" class="auth-validation"></div>
    <div class="field-group"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" placeholder="Your full name" autocomplete="name"/><span asp-validation-for="FullName" class="field-error"></span></div>
    <div class="field-group"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" placeholder="you@company.com" autocomplete="username"/><span asp-validation-for="Email" class="field-error"></span></div>
    <div class="field-group"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" placeholder="At least 10 characters" autocomplete="new-password"/><span asp-validation-for="Password" class="field-error"></span></div>
    <div class="field-group"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter your password" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="field-error"></span></div>
    <button type="submit" class="btn btn-primary auth-submit">Create HR account <span>→</span></button></form><div class="auth-secure"><span>◈</span> Passwords are securely hashed before storage</div></div><div class="auth-panel-foot"><a asp-action="Login">← Back to sign in</a></div></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }

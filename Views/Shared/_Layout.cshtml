<!DOCTYPE html>
@{
    string? currentController = Convert.ToString(ViewContext.RouteData.Values["controller"]);
    bool isDashboard = currentController == "Home";
    bool isEmployeePage = currentController == "Employees";
    bool isDepartmentPage = currentController == "DepartmentsController" || currentController == "Departments";
    bool isJobTitlePage = currentController == "JobTitlesController" || currentController == "JobTitles";
    bool isAccountPage = currentController == "Account";
    bool isMyProfile = isAccountPage && Convert.ToString(ViewContext.RouteData.Values["action"]) == "Profile";
    bool isAuthPage = isAccountPage && (Convert.ToString(ViewContext.RouteData.Values["action"]) is "Login" or "Register" or "Setup" or "AccessDenied" or "ForgotPassword" or "ResetPassword" or "ResetComplete");
    bool isHr = User.IsInRole("HR");
    bool isEmployee = User.IsInRole("Employee");
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · PeopleDesk</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EmployeeManagementSystem.styles.css" asp-append-version="true" />
</head>
<body class="@(isAuthPage ? "auth-body" : "")">
    @if (isAuthPage)
    {
        <main class="auth-main">@RenderBody()</main>
    }
    else
    {
        <div class="app-shell">
            <aside class="sidebar">
                <a class="brand" asp-controller="@(isEmployee ? "Portal" : "Home")" asp-action="Index"><img class="brand-logo-mark" src="~/images/peopledesk-mark.png" alt="PeopleDesk logo"/><span class="brand-copy"><strong>people<span>desk</span></strong><small>PEOPLE OPERATIONS</small></span></a>
                <div class="workspace-label">WORKSPACE</div>
                <nav class="side-nav" aria-label="Main navigation">
                    @if (isHr)
                    {
                        <a class="side-link @(isDashboard ? "active" : "")" asp-controller="Home" asp-action="Index"><span class="nav-icon">⌂</span> Overview</a>
                        <div class="nav-section-title">PEOPLE</div>
                        <a class="side-link @(isEmployeePage ? "active" : "")" asp-controller="Employees" asp-action="Index"><span class="nav-icon">♙</span> Employees</a>
                        <a class="side-link @(isDepartmentPage ? "active" : "")" asp-controller="Departments" asp-action="Index"><span class="nav-icon">▦</span> Departments</a>
                        <a class="side-link @(isJobTitlePage ? "active" : "")" asp-controller="JobTitles" asp-action="Index"><span class="nav-icon">▤</span> Job titles</a>
                        <a class="side-link @(currentController == "WorkTracking" ? "active" : "")" asp-controller="WorkTracking" asp-action="Index"><span class="nav-icon">◷</span> Attendance & tasks</a>
                        <a class="side-link @(currentController == "EmployeeChangeRequests" ? "active" : "")" asp-controller="EmployeeChangeRequests" asp-action="Index"><span class="nav-icon">✓</span> Profile requests</a>
                        <div class="nav-section-title nav-section-spaced">ACCESS</div>
                        <a class="side-link @(isAccountPage ? "active" : "")" asp-controller="Account" asp-action="Users"><span class="nav-icon">♧</span> User accounts</a>
                        <div class="sidebar-note"><span class="note-dot"></span><span><strong>HR workspace</strong><small>People access and records</small></span></div>
                    }
                    else if (isEmployee)
                    {
                        <a class="side-link active" asp-controller="Portal" asp-action="Index"><span class="nav-icon">♙</span> My profile</a>
                        <div class="nav-section-title nav-section-spaced">YOUR WORKSPACE</div>
                        <div class="sidebar-note"><span class="note-dot"></span><span><strong>Employee access</strong><small>Your personal workspace</small></span></div>
                    }
                </nav>
                <div class="sidebar-bottom">
                    <a class="user-chip" asp-controller="@(isEmployee ? "Portal" : "Account")" asp-action="Profile" title="Open your personal information"><span class="user-avatar">@((User.Identity?.Name ?? "P").Split(' ').FirstOrDefault()?.FirstOrDefault())</span><span class="user-copy"><strong>@User.Identity?.Name</strong><small>@(isHr ? "HR administrator · My profile" : "Employee · My profile")</small></span></a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar-logout-form"><button class="sidebar-logout" type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3m9-8h6a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-6"/></svg><span>Sign out</span></button></form>
                </div>
            </aside>
            <div class="app-main">
                <header class="topbar"><div class="breadcrumb-line"><span>Workspace</span><span class="crumb-separator">/</span><strong>@(isDashboard ? "Overview" : isEmployeePage ? "Employees" : isDepartmentPage ? "Departments" : isJobTitlePage ? "Job titles" : isMyProfile ? "My profile" : isAccountPage && Convert.ToString(ViewContext.RouteData.Values["action"]) == "Users" ? "User accounts" : ViewData["Title"])</strong></div></header>
                <main role="main" class="page-content">
                    @if (TempData["Success"] is string successMessage) { <div class="app-flash app-flash-success">@successMessage</div> }
                    @if (TempData["Error"] is string errorMessage) { <div class="app-flash app-flash-error">@errorMessage</div> }
                    @RenderBody()
                </main>
                <footer class="app-footer"><span>PeopleDesk · Employee management</span><span>Made for better workdays <span class="footer-heart">♥</span></span></footer>
            </div>
        </div>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

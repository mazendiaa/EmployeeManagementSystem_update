@model EmployeeManagementSystem.Models.WorkTrackingViewModel
@using EmployeeManagementSystem.Models
@{ ViewData["Title"] = "Attendance & tasks"; var monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month); }
<section class="tracking-page">
    <div class="employees-heading tracking-heading"><div><span class="eyebrow">PEOPLE OPERATIONS</span><h1>Attendance & tasks</h1><p class="page-subtitle">A monthly view of team attendance and assigned work.</p></div><a asp-controller="Employees" asp-action="Index" class="btn btn-light">Employee directory</a></div>
    <form method="get" class="tracking-filters"><div><label for="tracking-month">Month</label><select id="tracking-month" name="month" class="form-select">@for (var m = 1; m <= 12; m++) { <option value="@m" selected="@(Model.Month == m)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option> }</select></div><div><label for="tracking-year">Year</label><input id="tracking-year" type="number" name="year" value="@Model.Year" class="form-control" min="2000" max="@(DateTime.Today.Year + 1)"/></div><div><label for="tracking-employee">Employee</label><select id="tracking-employee" name="employeeId" asp-items="ViewBag.EmployeeOptions" class="form-select"><option value="">Everyone</option></select></div><button type="submit" class="btn btn-primary">Show report</button></form>
    <div class="tracking-stats"><article><span>ATTENDANCE RECORDS</span><strong>@Model.Attendance.Count</strong><small>@monthName @Model.Year</small></article><article><span>HOURS RECORDED</span><strong>@Model.Attendance.Where(a => a.ClockIn.HasValue && a.ClockOut.HasValue).Sum(a => (a.ClockOut!.Value - a.ClockIn!.Value).TotalHours).ToString("0.#")</strong><small>Completed shifts</small></article><article><span>TASKS COMPLETED</span><strong>@Model.Tasks.Count(t => t.Status == EmployeeTaskStatuses.Completed)</strong><small>Of @Model.Tasks.Count in this view</small></article><article><span>STILL IN PROGRESS</span><strong>@Model.Tasks.Count(t => t.Status != EmployeeTaskStatuses.Completed)</strong><small>Assigned work to follow up</small></article></div>
    <div class="tracking-grid">
        <section class="surface-card tracking-panel"><div class="card-heading"><div><h2>Attendance</h2><p>Clock-in and clock-out records for @monthName</p></div></div>
            <div class="table-responsive table-shell"><table class="table tracking-table align-middle"><thead><tr><th>Employee / date</th><th>Clock in</th><th>Clock out</th><th>Notes</th><th>Save</th></tr></thead><tbody>
            @foreach (var record in Model.Attendance)
            {
                <tr><td><a asp-controller="Employees" asp-action="Details" asp-route-id="@record.EmployeeId" class="tracking-employee">@record.Employee?.FullName</a><small class="tracking-date">@record.WorkDate.ToString("ddd, MMM d")</small></td><td colspan="4"><div class="tracking-row-controls"><form asp-action="UpdateAttendance" method="post" class="inline-edit-form"><input type="hidden" name="id" value="@record.Id"/><input type="hidden" name="workDate" value="@record.WorkDate.ToString("yyyy-MM-dd")"/><input type="hidden" name="month" value="@Model.Month"/><input type="hidden" name="year" value="@Model.Year"/><input type="hidden" name="employeeId" value="@Model.EmployeeId"/><input aria-label="Clock in" type="time" name="clockIn" class="form-control" value="@record.ClockIn?.ToString(@"hh\:mm")"/><input aria-label="Clock out" type="time" name="clockOut" class="form-control" value="@record.ClockOut?.ToString(@"hh\:mm")"/><input aria-label="Notes" type="text" name="notes" class="form-control notes-input" value="@record.Notes" placeholder="Add a note"/><button class="btn btn-sm btn-light" type="submit">Save</button></form><form asp-action="DeleteAttendance" method="post"><input type="hidden" name="id" value="@record.Id"/><input type="hidden" name="month" value="@Model.Month"/><input type="hidden" name="year" value="@Model.Year"/><input type="hidden" name="employeeId" value="@Model.EmployeeId"/><button type="submit" class="row-action row-action-delete" title="Remove attendance record" aria-label="Remove attendance record">×</button></form></div></td></tr>
            }
            @if (!Model.Attendance.Any()) { <tr><td colspan="5" class="table-empty">No attendance records match this view yet.</td></tr> }
            </tbody></table></div>
            <details class="add-record-details"><summary>＋ Add attendance record</summary><form asp-action="RecordAttendance" method="post" class="add-record-form"><input type="hidden" name="month" value="@Model.Month"/><input type="hidden" name="year" value="@Model.Year"/><label>Employee<select name="EmployeeId" asp-items="ViewBag.EmployeeOptions" class="form-select" required><option value="">Choose employee</option></select></label><label>Date<input name="WorkDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required/></label><label>Clock in<input name="ClockIn" type="time" class="form-control"/></label><label>Clock out<input name="ClockOut" type="time" class="form-control"/></label><label>Notes<input name="Notes" type="text" maxlength="400" class="form-control" placeholder="Optional"/></label><button type="submit" class="btn btn-primary">Save attendance</button></form></details>
        </section>
        <section class="surface-card tracking-panel"><div class="card-heading"><div><h2>Assigned tasks</h2><p>Work due, assigned, or completed in @monthName</p></div></div>
            <div class="tracking-task-list">
                @foreach (var task in Model.Tasks)
                {
                    <article class="tracking-task"><div class="tracking-task-top"><span class="task-status-pill task-status-@task.Status.ToLowerInvariant().Replace(" ", "-")">@task.Status</span><a asp-controller="Employees" asp-action="Details" asp-route-id="@task.EmployeeId">@task.Employee?.FullName</a></div><form asp-action="UpdateTask" method="post" class="tracking-task-form"><input type="hidden" name="id" value="@task.Id"/><input type="hidden" name="month" value="@Model.Month"/><input type="hidden" name="year" value="@Model.Year"/><input type="hidden" name="employeeId" value="@Model.EmployeeId"/><label>Title<input name="title" class="form-control" maxlength="140" value="@task.Title" required/></label><label>Description<textarea name="description" class="form-control" maxlength="1000" rows="2">@task.Description</textarea></label><div class="task-form-bottom"><label>Due date<input name="dueDate" type="date" class="form-control" value="@task.DueDate?.ToString("yyyy-MM-dd")"/></label><label>Status<select name="status" class="form-select"><option selected="@(task.Status == EmployeeTaskStatuses.Assigned)">@EmployeeTaskStatuses.Assigned</option><option selected="@(task.Status == EmployeeTaskStatuses.InProgress)">@EmployeeTaskStatuses.InProgress</option><option selected="@(task.Status == EmployeeTaskStatuses.Completed)">@EmployeeTaskStatuses.Completed</option></select></label><button class="btn btn-sm btn-light" type="submit">Save</button></div></form><form asp-action="DeleteTask" method="post" class="task-delete-form"><input type="hidden" name="id" value="@task.Id"/><input type="hidden" name="month" value="@Model.Month"/><input type="hidden" name="year" value="@Model.Year"/><input type="hidden" name="employeeId" value="@Model.EmployeeId"/><button type="submit" class="text-danger-link">Remove task</button></form></article>
                }
                @if (!Model.Tasks.Any()) { <div class="tracking-empty"><span>✦</span><strong>No tasks in this view yet</strong><p>Assign work to an employee to start tracking progress.</p></div> }
            </div>
            <details class="add-record-details"><summary>＋ Assign a task</summary><form asp-action="AssignTask" method="post" class="tracking-task-form new-task-form"><input type="hidden" name="month" value="@Model.Month"/><input type="hidden" name="year" value="@Model.Year"/><label>Employee<select name="EmployeeId" asp-items="ViewBag.EmployeeOptions" class="form-select" required><option value="">Choose employee</option></select></label><label>Task title<input name="Title" class="form-control" maxlength="140" required placeholder="e.g. Prepare monthly report"/></label><label>Description<textarea name="Description" class="form-control" rows="2" maxlength="1000" placeholder="What needs to be done?"></textarea></label><label>Due date<input name="DueDate" type="date" class="form-control"/></label><button type="submit" class="btn btn-primary">Assign task</button></form></details>
        </section>
    </div>
</section>

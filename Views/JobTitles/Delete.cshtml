@model EmployeeManagementSystem.Models.JobTitle
@{ ViewData["Title"] = "Delete job title"; }
<section class="edit-page"><a asp-action="Index" class="back-link">← All job titles</a><div class="edit-heading"><span class="eyebrow">PEOPLE DIRECTORY</span><h1>Delete job title?</h1><p>This action can't be undone.</p></div><div class="surface-card edit-card"><div class="delete-summary"><span class="delete-mark">!</span><div><strong>@Model.Title</strong><p>Employees assigned to this role prevent it from being deleted.</p></div></div><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button type="submit" class="btn btn-danger">Delete job title</button> <a asp-action="Index" class="btn btn-light">Keep job title</a></form></div></section>

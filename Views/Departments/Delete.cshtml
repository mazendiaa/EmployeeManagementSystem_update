@model EmployeeManagementSystem.Models.Department
@{ ViewData["Title"] = "Delete department"; }
<section class="edit-page"><a asp-action="Index" class="back-link">← All departments</a><div class="edit-heading"><span class="eyebrow">PEOPLE DIRECTORY</span><h1>Delete department?</h1><p>This action can't be undone.</p></div><div class="surface-card edit-card"><div class="delete-summary"><span class="delete-mark">!</span><div><strong>@Model.Name</strong><p>Employees assigned to this department prevent it from being deleted.</p></div></div><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button type="submit" class="btn btn-danger">Delete department</button> <a asp-action="Index" class="btn btn-light">Keep department</a></form></div></section>
